{{- $posts := where (where site.RegularPages "Section" "posts") "Draft" false -}}
{{- $items := slice -}}
{{- range $posts.ByDate.Reverse -}}
  {{- $md := "" -}}{{- with .OutputFormats.Get "markdown" }}{{ $md = .Permalink }}{{ end -}}
  {{- $item := dict
      "id" .Permalink
      "url" .Permalink
      "title" .Title
      "summary" (.Params.summary | default .Description | default .Summary | plainify | htmlUnescape)
      "content_html" .Content
      "date_published" (.Date.Format "2006-01-02T15:04:05-07:00")
      "date_modified" (.Lastmod.Format "2006-01-02T15:04:05-07:00")
      "tags" (.Params.tags | default slice)
      "language" "zh-TW"
      "_markdown_url" $md
  -}}
  {{- $items = $items | append $item -}}
{{- end -}}
{{- $feed := dict
    "version" "https://jsonfeed.org/version/1.1"
    "title" site.Title
    "home_page_url" site.BaseURL
    "feed_url" ("feed.json" | absURL)
    "description" site.Params.description
    "language" "zh-TW"
    "authors" (slice (dict "name" site.Params.author))
    "items" $items
-}}
{{- $feed | jsonify (dict "indent" "  ") -}}
